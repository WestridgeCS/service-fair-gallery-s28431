<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

<main>

<a href="/projects/<%= project._id%>/own">← Cancel</a>

<h1>Edit Project</h1>

<form action="/projects/<%= project._id %>" method="POST">
  <label>Title</label>
  <input 
    name="title" 
    value="<%= project.title %>" 
    required 
  />

  <label>Subtitle</label>
  <input 
    name="subtitle" 
    value="<%= project.subtitle %>" 
    required 
  />
  
  <label>CTS or CAP</label>
  <input 
    name="ctsorcap" 
    value="<%= project.ctsorcap %>" 
    required 
  />

  <label>Description</label>
  <textarea 
    name="description" 
    required
  ><%= project.description %></textarea>

  <button type="submit">Save Changes</button>
</form>

<form action="/projects/<%= project._id %>/delete" method="POST">
  <button type="submit">Delete Project</button>
</form>

</main>

</body>
</html>

