<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
<main>

<div class="titlesort">
<h1>Service Fair Projects</h1>
<form method="GET" action="/">
  <label>Sort by title:</label>
  <select name="sort" onchange="this.form.submit()">
    <option value="az" <%= currentSort === 'az' ? 'selected' : '' %>>
      A - Z
    </option>
    <option value="za" <%= currentSort === 'za' ? 'selected' : '' %>>
      Z - A
    </option>
  </select>
</form>
</div>

<div class="create">
<h2>Create a Project</h2>
<form class="createform"action="/projects" method="POST">
  <input name="title" placeholder="Project Title" required />
  <input name="subtitle" placeholder="Subtitle" required />
  <input name="ctsorcap" placeholder="CAP" required />
  <textarea name="description" placeholder="Project Description" required></textarea>
  <button type="submit">Create Project</button>
</form>
</div>

<div class="projects">
<h2>All Projects</h2>

<% if (projects.length === 0) { %>
  <p>No projects yet.</p>
<% } %>

<div class="cards">
  <% projects.forEach(project => { %>
    <a href="/projects/<%= project._id%>/own">
      <div class="card">
        <h3>
            <%= project.title %>
          
        </h3>
        <p><%= project.subtitle %> ~ <%= project.ctsorcap %></p>
      </div>
    </a>
  <% }) %>
</div>
</div>


</main>

</body>
</html>







