<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
<main>

<div class="titlesort">
<h1><a href="https://portals.veracross.com/westridge/student"><img class="wimg" src="imgs/westlogo.png" alt=""/></a>Service Fair Projects</h1>
<form method="GET" action="/">
  <label>Sort by title:</label>
  <select name="sort" onchange="this.form.submit()">
    <option value="az" <%= currentSort === 'az' ? 'selected' : '' %>>
      A - Z
    </option>
    <option value="za" <%= currentSort === 'za' ? 'selected' : '' %>>
      Z - A
    </option>
  </select>
</form>
</div>

<div class="projects">
<h2>All Projects</h2>

<% if (projects.length === 0) { %>
  <p>No projects yet.</p>
<% } %>

<div class="cards">
  <% projects.forEach(project => { %>
    <a href="/projects/<%= project._id%>">
      <div class="card">
        <h3>
            <%= project.title %>
          
        </h3>
        <p><%= project.subtitle %> ~ <%= project.ctsorcap %></p>
      </div>
    </a>
  <% }) %>
</div>
</div>

<a href="/projectOWN">super well hidden create and edit page</a>

</main>

</body>
</html>
